# Copy to .env.local for local testing against Supabase, or set these as
# Environment Variables in the Vercel project dashboard for the real deploy.
# server.js (plain local run) does not read these — it uses data/watchlist.json.

# Supabase project settings -> API
SUPABASE_URL=https://rrhiizxshypqcvfxqjsr.supabase.co
# service_role secret key — used server-side only, to read/write the
# watchlist table and to verify signed-in users' tokens.
SUPABASE_SERVICE_ROLE_KEY=

# The public anon key is NOT set here — it's not a secret, and there's no
# build step to inject env vars into static files, so it goes directly into
# public/supabase-config.js (along with SUPABASE_URL) instead.
